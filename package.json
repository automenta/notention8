{
  "name": "notention-monorepo",
  "private": true,
  "workspaces": [
    "ui",
    "agent",
    "core"
  ],
  "scripts": {
    "dev": "tsx dev-server.ts",
    "dev-agent": "npm run start --workspace=@notention/agent",
    "dev-ui": "npm run dev --workspace=@notention/ui",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@notention/ui"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "~5.9.2"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}