{
  "name": "notention-monorepo",
  "private": true,
  "workspaces": [
    "ui",
    "agent",
    "core"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=@notention/ui\" \"npm run dev --workspace=core\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspace=@notention/ui",
    "dev:agent": "npm run dev --workspace=@notention/agent"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}